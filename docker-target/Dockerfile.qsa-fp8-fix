# One-file overlay on the official day-1 image: backports
# sgl-project/sglang@d6ff2d881e78d0746e0393e9860ce3de5d84de8b
# ("Cast gathered fp8 KV to compute dtype before Triton sparse GQA decode")
# onto lmsysorg/sglang:qwen38flashnext (commit 593134d17, 2026-09-03), which does not
# have it: the QSA forward_extend() prefix-hit branch gathers K/V straight from the
# fp8_e4m3 KV pool and calls sparse_gqa_fwd_interface_triton_ck() without casting,
# so tl.dot(bf16 q, fp8 k) fails to compile ("Unsupported rhs dtype fp8e4nv") on any
# request that hits cached prefix under fp8 KV (2nd+ chunked-prefill chunk, or a
# radix-cache-hit multi-turn request). Fresh requests with no prefix take a
# different branch with freshly-computed bf16 k/v and never hit this.
#
# The companion fix in the same source lineage, sgl-project/sglang@fa862ff2 (route
# QSA sparse decode through trtllm-gen on SM120 too), is NOT re-applied here: this
# image already has the equivalent gate (`is_sm100_supported() or is_sm120()` in
# qwen_sparse_attn_backend.py's _resolve_trtllm_sparse_decode), just under a
# differently-named helper — it was independently fixed upstream.
FROM lmsysorg/sglang:qwen38flashnext

COPY patches-official/qwen_sparse_attn_backend.py \
  /sgl-workspace/sglang/python/sglang/srt/layers/attention/qwen_sparse_attn_backend.py

RUN python3 -c "import ast; ast.parse(open('/sgl-workspace/sglang/python/sglang/srt/layers/attention/qwen_sparse_attn_backend.py').read()); print('qwen_sparse_attn_backend.py syntax OK')" \
 && python3 -c "import sglang.srt.layers.attention.qwen_sparse_attn_backend; print('import OK')"

# Second overlay on the same base image: fixes a transient full-size GPU
# allocation in Qwen4ExpNGramEmbedding.__init__ (qwen4_exp.py) that occurs
# whenever --ple-offload-embedding is combined with a PLE table stored at
# BF16 (i.e. --json-model-override-args '{"text_config":
# {"ple_embedding_dtype": null}}', see docs/09-PRIMITIVE-RAM-OFFLOAD.md).
# VocabParallelEmbedding's underlying UnquantizedEmbeddingMethod.create_weights
# (layers/quantization/unquant.py) allocates its initial tensor with no
# device= kwarg, so it lands on CUDA via the ambient `with torch.device("cuda"):`
# context that DefaultModelLoader.initialize_model_for_startup wraps model
# construction in (model_loader/loader.py) -- a ~48GB (fp8) or ~95GB (bf16)
# transient spike, freed moments later by Qwen4ExpPinnedHostEmbedding.__init__
# copying it to pinned host RAM, but PyTorch's CUDA caching allocator does not
# reliably return that freed VRAM to the driver, and on a near-full card this
# spike alone can OOM the mamba/linear-attention state-cache sizing that runs
# right after model construction ("Not enough GPU memory for hybrid
# (mamba/linear-attention) state cache"). Reproduced live: fp8 (~48GB spike)
# boots fine at --mem-fraction-static 0.96; bf16 (~95GB spike) OOMs with that
# exact error.
#
# Fix: construct just the VocabParallelEmbedding under `with torch.device("cpu"):`
# whenever config.ple_offload_embedding is set -- there's no reason for a
# table whose final home is pinned host RAM to ever touch the GPU. Not an
# upstream commit backport (no matching fix found upstream as of 593134d17);
# this is a local root-caused fix using an idiom already present elsewhere in
# this same sglang codebase for defeating an ambient CUDA default-device
# context (utils/common.py's device_context() helper; models/transformers.py
# ~L257-259; lora/backend/chunked_backend.py ~L485,535).
COPY patches-official/qwen4_exp.py \
  /sgl-workspace/sglang/python/sglang/srt/models/qwen4_exp.py

RUN python3 -c "import ast; ast.parse(open('/sgl-workspace/sglang/python/sglang/srt/models/qwen4_exp.py').read()); print('qwen4_exp.py syntax OK')" \
 && python3 -c "import sglang.srt.models.qwen4_exp; print('import OK')"

# Third overlay: backport of sgl-project/sglang#32468 (still OPEN upstream as of
# 593134d17) -- moves the draft's init_token_map()/init_lm_head() out of
# alloc_memory_pool() and into EagleDraftWorker.__init__, so the draft's own
# embed/lm_head copies are freed (torch.cuda.empty_cache) BEFORE the scheduler's
# init_target_memory_pool() profiles free memory to size the KV cache, instead
# of being freed into an already-fixed budget afterwards.
#
# Measured on this box, not estimated: with the stock order the draft-owned
# copies cost ~1.3 GB at boot (draft loaded with
# --speculative-draft-model-quantization fp8; vocab 248320 x hidden 2560), so
# the expected effect is roughly +110K KV tokens (520960 -> ~630K at the
# default fp8_e4m3 KV) or equivalent FRACTION headroom -- NOT a crash fix:
# this profile already boots CTX=262144 at FRACTION=0.96 unpatched, with 4.59 GB
# to spare. Re-verified against this image's stock file: only the 3-line
# reorder is applied (stock drifted ~170 diff lines vs the old
# patches/eagle_worker_v2.py: get_spec()/get_parallel() refactor,
# unwrap_lora_layer, draft_pp_context -- copying the old file would regress
# all of it). One behavior delta: with --speculative-use-rejection-sampling,
# the draft/target vocab-mismatch ValueError now fires at worker construction
# instead of pool allocation (unused by this profile).
COPY patches-official/eagle_worker_v2.py \
  /sgl-workspace/sglang/python/sglang/srt/speculative/eagle_worker_v2.py

RUN python3 -c "import ast; ast.parse(open('/sgl-workspace/sglang/python/sglang/srt/speculative/eagle_worker_v2.py').read()); print('eagle_worker_v2.py syntax OK')" \
 && python3 -c "import inspect; from sglang.srt.speculative import eagle_worker_v2 as e; s=inspect.getsource(e.EagleDraftWorker.__init__); a=inspect.getsource(e.EagleDraftWorker.alloc_memory_pool); assert 'init_lm_head()' in s and 'empty_cache' in s, 'patch missing from __init__'; assert 'init_lm_head()' not in a, 'init_lm_head still in alloc_memory_pool'; print('eagle_worker_v2 #32468 backport OK')"
